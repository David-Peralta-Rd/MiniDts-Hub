---
import "../styles/global.css";
const { title = "MiniDts-Hub" } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 text-slate-100">
    <header class="w-full px-6 py-4 backdrop-blur-glass bg-glass border-b border-glass">
      <nav class="max-w-7xl mx-auto flex items-center justify-between">
        <a href={import.meta.env.BASE_URL} class="font-bold text-xl">MiniDts-Hub</a>
        <div class="flex gap-4">
          <a href={`${import.meta.env.BASE_URL}projects/`} class="hover:underline">Proyectos</a>
          <a href={`${import.meta.env.BASE_URL}news/`} class="hover:underline">Novedades</a>
        </div>
      </nav>
    </header>
    <main class="w-full px-6 py-8">
      <slot />
    </main>
  </body>
</html>