---
import Layout from "@layouts/Layout.astro";
import type { Project } from "@modules/projects/public";
import { collectTags } from "@modules/projects/public";
import projectsData from "../../../generated/projects.json";

const locale = Astro.currentLocale || "en";
const projects = (projectsData as Project[])
  .slice()
  .sort((a, b) => Number(b.featured) - Number(a.featured));
const tags = collectTags(projects);
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + "/";
const pSummary = (p: Project) => (locale === "en" && p.summary_en ? p.summary_en : p.summary);
const pDescription = (p: Project) => (locale === "en" ? p.description_en : p.description);
---
<Layout title="Projects — MiniDts-Hub">
  <section class="max-w-7xl mx-auto">
    <h1 class="text-4xl font-bold mb-4">Projects</h1>
    <div class="flex flex-wrap gap-2 mb-8" id="tag-chips">
      <a href={`${base}en/projects/`} data-tag="" class="tag-chip px-3 py-1 rounded-full border border-glass">All</a>
      {tags.map((t) => (
        <a href={`${base}en/projects/?tag=${encodeURIComponent(t)}`} data-tag={t} class="tag-chip px-3 py-1 rounded-full border border-glass">{t}</a>
      ))}
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="project-grid">
      {projects.map((p) => (
        <article class="glass p-6 project-card transition hover:scale-[1.02] hover:shadow-lg hover:shadow-sky-500/20" data-tags={p.tags.join(",")}>
          <h2 class="text-xl font-semibold flex items-center gap-2">{p.title}{p.featured && <span class="text-xs bg-sky-500/30 px-2 py-0.5 rounded">Featured</span>}</h2>
          <div class="mt-3 rounded-lg bg-white/5 border border-white/10 p-3">
            <p class="text-slate-200 text-justify">{pSummary(p)}</p>
            {pDescription(p) && <p class="text-slate-300 text-justify mt-2 text-sm">{pDescription(p)}</p>}
          </div>
          <div class="flex flex-wrap gap-2 mt-3">
            {p.tags.map((t) => <span class="text-xs bg-sky-500/15 text-sky-300 px-2 py-0.5 rounded-full">#{t}</span>)}
          </div>
          <div class="flex gap-3 mt-4">
            {p.repo_url && (
              <a href={p.repo_url} class="inline-flex items-center gap-1 text-sky-400 hover:text-sky-300">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.73.5.5 5.73.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56 0-.28-.01-1.02-.02-2-3.2.7-3.88-1.54-3.88-1.54-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.43-2.7 5.4-5.26 5.69.42.36.78 1.08.78 2.18 0 1.58-.01 2.85-.01 3.24 0 .31.21.68.8.56A11.51 11.51 0 0 0 23.5 12C23.5 5.73 18.27.5 12 .5z"/></svg>
                Repository
              </a>
            )}
            {p.demo_url && <a href={p.demo_url} class="text-sky-400">Demo</a>}
          </div>
        </article>
      ))}
    </div>
    <p id="empty-msg" class="text-slate-400 mt-6 hidden">No projects for this filter.</p>
  </section>
  <script>
    const params = new URLSearchParams(window.location.search);
    const active = (params.get("tag") || "").toLowerCase();
    document.querySelectorAll(".tag-chip").forEach((c) => {
      const t = (c.getAttribute("data-tag") || "").toLowerCase();
      if (t === active) c.classList.add("bg-glass", "ring-2", "ring-sky-400");
    });
    let visible = 0;
    document.querySelectorAll(".project-card").forEach((card) => {
      const tags = (card.getAttribute("data-tags") || "").toLowerCase().split(",");
      const show = !active || tags.includes(active);
      (card as HTMLElement).style.display = show ? "" : "none";
      if (show) visible++;
    });
    const empty = document.getElementById("empty-msg");
    if (empty && visible === 0) empty.classList.remove("hidden");
  </script>
</Layout>