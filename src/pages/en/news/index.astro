---
import Layout from "@layouts/Layout.astro";
import type { NewsItem } from "@modules/news/public";
import { groupNewsByYear } from "@modules/news/public";
import newsData from "../../../generated/news.json";

const locale = Astro.currentLocale || "en";
const items = newsData as NewsItem[];
const groups = groupNewsByYear(items);
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + "/";
const nTitle = (n: NewsItem) => (locale === "en" && n.title_en ? n.title_en : n.title);
const nSummary = (n: NewsItem) => (locale === "en" && n.summary_en ? n.summary_en : n.summary);
---
<Layout title="News — MiniDts-Hub">
  <section class="max-w-7xl mx-auto">
    <h1 class="text-4xl font-bold mb-4">News</h1>
    <div class="flex flex-wrap gap-2 mb-8" id="year-chips">
      <a href={`${base}en/news/`} data-year="" class="year-chip px-3 py-1 rounded-full border border-glass">All</a>
      {groups.map((g) => (
        <a href={`${base}en/news/?year=${encodeURIComponent(g.year)}`} data-year={g.year} class="year-chip px-3 py-1 rounded-full border border-glass">{g.year}</a>
      ))}
    </div>
    <div class="space-y-6" id="news-list">
      {items
        .slice()
        .sort((a, b) => b.version.localeCompare(a.version))
        .map((n) => (
        <article class="glass p-6 news-card transition hover:scale-[1.02] hover:shadow-lg hover:shadow-sky-500/20" data-year={n.version.split(/[.\-]/)[0].length === 2 ? `20${n.version.split(/[.\-]/)[0]}` : n.version.split(/[.\-]/)[0]}>
          <span class="text-xs text-slate-400">{n.version} · {n.category}</span>
          <h2 class="text-xl font-semibold mt-1">{nTitle(n)}</h2>
          <div class="mt-3 rounded-lg bg-white/5 border border-white/10 p-3">
            <p class="text-slate-200 text-justify">{nSummary(n)}</p>
          </div>
        </article>
      ))}
    </div>
    <p id="empty-msg" class="text-slate-400 mt-6 hidden">No news for this year.</p>
  </section>
  <script>
    const params = new URLSearchParams(window.location.search);
    const active = params.get("year") || "";
    document.querySelectorAll(".year-chip").forEach((c) => {
      if ((c.getAttribute("data-year") || "") === active) c.classList.add("bg-glass", "ring-2", "ring-sky-400");
    });
    let visible = 0;
    document.querySelectorAll(".news-card").forEach((card) => {
      const y = card.getAttribute("data-year") || "";
      const show = !active || y === active;
      (card as HTMLElement).style.display = show ? "" : "none";
      if (show) visible++;
    });
    const empty = document.getElementById("empty-msg");
    if (empty && visible === 0) empty.classList.remove("hidden");
  </script>
</Layout>