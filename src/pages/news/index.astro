---
import Layout from "@layouts/Layout.astro";
import type { NewsItem } from "@modules/news/public";
import { filterNewsByYear, groupNewsByYear } from "@modules/news/public";
import newsData from "../../generated/news.json";

const items = newsData as NewsItem[];
const activeYear = Astro.url.searchParams.get("year");
const visible = filterNewsByYear(items, activeYear);
const groups = groupNewsByYear(items);
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + "/";
---
<Layout title="Novedades — MiniDts-Hub">
  <section class="max-w-7xl mx-auto">
    <h1 class="text-4xl font-bold mb-4">Novedades</h1>
    <div class="flex flex-wrap gap-2 mb-8">
      <a
        href={`${base}news/`}
        class={`px-3 py-1 rounded-full border border-glass ${!activeYear ? "bg-glass" : ""}`}
      >
        Todos
      </a>
      {groups.map((g) => (
        <a
          href={`${base}news/?year=${encodeURIComponent(g.year)}`}
          class={`px-3 py-1 rounded-full border border-glass ${activeYear === g.year ? "bg-glass" : ""}`}
        >
          {g.year}
        </a>
      ))}
    </div>
    <div class="space-y-6">
      {visible
        .slice()
        .sort((a, b) => b.version.localeCompare(a.version))
        .map((n) => (
        <article class="glass p-6">
          <span class="text-xs text-slate-400">{n.version} · {n.category}</span>
          <h2 class="text-xl font-semibold mt-1">{n.title}</h2>
          <p class="text-slate-300 mt-2">{n.summary}</p>
        </article>
      ))}
    </div>
    {visible.length === 0 && <p class="text-slate-400 mt-6">No hay novedades para este año.</p>}
  </section>
</Layout>