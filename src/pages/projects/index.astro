---
import Layout from "@layouts/Layout.astro";
import type { Project } from "@modules/projects/public";
import projectsData from "../../generated/projects.json";
const projects = projectsData as Project[];
---
<Layout title="Proyectos — MiniDts-Hub">
  <section class="max-w-7xl mx-auto">
    <h1 class="text-4xl font-bold mb-8">Proyectos</h1>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {projects.map((p) => (
        <article class="glass p-6">
          <h2 class="text-xl font-semibold">{p.title}</h2>
          <p class="text-slate-300 mt-2">{p.summary}</p>
          <div class="flex gap-3 mt-4">
            {p.repo_url && <a href={p.repo_url} class="text-sky-400">Repo</a>}
            {p.demo_url && <a href={p.demo_url} class="text-sky-400">Demo</a>}
          </div>
        </article>
      ))}
    </div>
  </section>
</Layout>