---
import Layout from "@layouts/Layout.astro";
import type { Project } from "@modules/projects/public";
import type { NewsItem } from "@modules/news/public";
import projectsData from "../generated/projects.json";
import newsData from "../generated/news.json";

const projects = (projectsData as Project[])
  .slice()
  .sort((a, b) => Number(b.featured) - Number(a.featured))
  .slice(0, 6);
const news = (newsData as NewsItem[])
  .slice()
  .sort((a, b) => b.version.localeCompare(a.version))
  .slice(0, 6);
---
<Layout title="MiniDts-Hub">
  <section class="max-w-7xl mx-auto">
    <h1 class="text-4xl font-bold mb-6">MiniDts-Hub</h1>
    <p class="text-slate-300 mb-10">Software y configuraciones minimalistas para Linux.</p>

    <h2 class="text-2xl font-semibold mb-4">Proyectos</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
      {projects.map((p) => (
        <article class="glass p-6 transition hover:scale-[1.02] hover:shadow-lg hover:shadow-sky-500/20">
          <h3 class="text-xl font-semibold flex items-center gap-2">{p.title}{p.featured && <span class="text-xs bg-sky-500/30 px-2 py-0.5 rounded">Destacado</span>}</h3>
          <div class="mt-3 rounded-lg bg-white/5 border border-white/10 p-3">
            <p class="text-slate-200 text-justify">{p.summary}</p>
          </div>
          <div class="flex flex-wrap gap-2 mt-3">
            {p.tags.map((t) => <span class="text-xs bg-sky-500/15 text-sky-300 px-2 py-0.5 rounded-full">#{t}</span>)}
          </div>
          {p.repo_url && (
            <a href={p.repo_url} class="inline-flex items-center gap-1 text-sky-400 hover:text-sky-300 mt-3">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.73.5.5 5.73.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56 0-.28-.01-1.02-.02-2-3.2.7-3.88-1.54-3.88-1.54-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.43-2.7 5.4-5.26 5.69.42.36.78 1.08.78 2.18 0 1.58-.01 2.85-.01 3.24 0 .31.21.68.8.56A11.51 11.51 0 0 0 23.5 12C23.5 5.73 18.27.5 12 .5z"/></svg>
              Repositorio
            </a>
          )}
        </article>
      ))}
    </div>

    <h2 class="text-2xl font-semibold mb-4">Novedades</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {news.map((n) => (
        <article class="glass p-6 transition hover:scale-[1.02] hover:shadow-lg hover:shadow-sky-500/20">
          <span class="text-xs text-slate-400">{n.version}</span>
          <h3 class="text-xl font-semibold mt-1">{n.title}</h3>
          <div class="mt-3 rounded-lg bg-white/5 border border-white/10 p-3">
            <p class="text-slate-200 text-justify">{n.summary}</p>
          </div>
        </article>
      ))}
    </div>
  </section>
</Layout>