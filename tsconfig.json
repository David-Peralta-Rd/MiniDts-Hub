{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@kernel/*": ["src/kernel/*"],
      "@modules/*": ["src/modules/*"],
      "@components/*": ["src/components/*"],
      "@layouts/*": ["src/layouts/*"]
    },
    "types": ["vitest/globals"]
  },
  "include": ["src", "tests"]
}